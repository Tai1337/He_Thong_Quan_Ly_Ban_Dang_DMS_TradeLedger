{
  "name": "dms-tradeledger-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter dms-npp-backend --filter dms-npp-frontend dev",
    "dev:backend": "pnpm --filter dms-npp-backend dev",
    "dev:frontend": "pnpm --filter dms-npp-frontend dev",
    "build": "pnpm --filter dms-npp-frontend build",
    "lint": "pnpm --filter dms-npp-frontend lint",
    "db:push": "pnpm --filter dms-npp-backend db:push",
    "db:seed": "pnpm --filter dms-npp-backend seed",
    "db:generate": "pnpm --filter dms-npp-backend generate"
  }
}
